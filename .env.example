# Copy to .env and fill in whichever key you have. The fetch script prefers
# NGX Pulse when both are set (override with --source).

# https://ngxpulse.ng/api — free Personal key issued instantly via the form.
# NOTE: the docs list "Historical data" under the Professional tier; the
# fetch script will tell you clearly if your key only returns snapshots.
NGX_PULSE_API_KEY=

# https://eodhd.com — NGX = exchange code XNSA. Free tier: 20 calls/day.
EODHD_API_TOKEN=
